# ===== Runtime =====
# production: 실제 운영. development: 로컬 개발(로그 상세).
NODE_ENV=development

# ===== Discord =====
# 봇 토큰 (Discord Developer Portal > Bot > Token).
DISCORD_TOKEN=
# 봇이 동작할 서버(길드) ID. 슬래시 명령어가 이 길드에 등록됩니다.
GUILD_ID=

# ===== Google Sheets =====
# 출석 현황 스프레드시트 ID (시트 URL의 /d/ 와 /edit 사이 값).
SPREADSHEET_ID=

# ===== 분반별 채널 =====
# 초급(Novice) 출석 보고용 텍스트 채널 ID.
NOVICE_CHANNEL_ID=
# 초급(Novice) 출석 확인용 음성 채널 ID.
NOVICE_VOICE_CHANNEL_ID=
# 중급(Advanced) 출석 보고용 텍스트 채널 ID.
ADVANCED_CHANNEL_ID=
# 중급(Advanced) 출석 확인용 음성 채널 ID.
ADVANCED_VOICE_CHANNEL_ID=

# ===== 분반 역할 =====
# 강의 링크 배포 시 학생의 분반을 판별하는 데 사용합니다.
# 초급(Novice) 수강생 역할 ID.
NOVICE_ROLE_ID=
# 중급(Advanced) 수강생 역할 ID.
ADVANCED_ROLE_ID=

# ===== 지원 구글폼 =====
# /역할버튼이 신청 분반(초급/중급)을 조회하는 폼 응답 스프레드시트 ID. 서비스계정에 뷰어 공유 필요.
# ⚠️ 시즌마다 폼이 바뀌면 forms.ts의 열 탐지도 함께 확인하세요.
# 내부인(신촌연합 재학생) 참가자 응답 시트 ID.
FORM_INTERNAL_ID=
# 외부인 참가자 응답 시트 ID.
FORM_EXTERNAL_ID=
